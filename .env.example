
# ==============================================================================
# OTT Content Aggregator API - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# PowerShell: Copy-Item .env.example .env
# Never commit real credentials or secrets.

# ------------------------------------------------------------------------------
# PostgreSQL / Docker Compose
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=ott_db
# Optional host port mapping
# POSTGRES_PORT=5432

# Database connection URL
# Docker Compose: use host "db"
# Local PostgreSQL: use host "localhost"
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_local_password@db:5432/ott_db

# Connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Security / JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure secret:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate_random_secret_at_least_32_bytes>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Application / CORS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# Redis Cache
# ------------------------------------------------------------------------------
# Docker Compose: redis://redis:6379/0
# Local Redis: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# External OTT Provider API
# ------------------------------------------------------------------------------
EXTERNAL_API_TIMEOUT_SECONDS=10.0
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_PROVIDER_BASE_URL=https://api.example-ott-provider.com
