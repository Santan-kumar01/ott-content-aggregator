# Database Connection (PostgreSQL asyncpg driver)
DATABASE_URL=postgresql+asyncpg://<postgres_user>:<postgres_password>@<postgres_host>:<postgres_port>/<postgres_db>

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Security & Authentication
# JWT_SECRET_KEY must be a cryptographically random secret of at least 32 bytes (256 bits) for HS256.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate_random_secret_at_least_32_bytes>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment & CORS Settings
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis Cache
REDIS_URL=redis://<redis_host>:<redis_port>/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# External OTT Provider API
EXTERNAL_API_TIMEOUT_SECONDS=10.0
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_PROVIDER_BASE_URL=https://api.example-ott-provider.com
