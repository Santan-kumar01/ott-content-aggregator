# ==============================================================================
# OTT Content Aggregator API - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Service Settings (Used by Docker Compose 'db' service)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
# Required: Password for PostgreSQL (Compose fails fast if unset; never leave blank)
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ott_db
# Optional host port mapping for local database tools (e.g. 5432)
# POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Database Connection URL (PostgreSQL asyncpg driver)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
#
# NOTE ON SPECIAL CHARACTERS:
# If POSTGRES_PASSWORD contains URL-special characters (e.g. '@', ':', '/', '#', '%'),
# URL-encode the password using:
#   python -c "import urllib.parse; print(urllib.parse.quote('your_password'))"
# And provide either:
#   1) POSTGRES_PASSWORD_ENCODED=<url_encoded_password>
#   2) COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:<url_encoded_password>@db:5432/ott_db
#
# When running with Docker Compose (service-to-service communication via 'db' host):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ott_db
# (Optional) Explicit override for Compose:
# COMPOSE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ott_db
#
# When running locally on host outside Docker (using local PostgreSQL on localhost):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ott_db

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY must be a cryptographically random secret of at least 32 bytes (256 bits).
# Generate one using:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate_random_secret_at_least_32_bytes>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Application & Cache Settings
# ------------------------------------------------------------------------------
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
